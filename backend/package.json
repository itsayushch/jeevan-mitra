{
  "name": "jeevanmitra-backend",
  "version": "2.0.0",
  "description": "JeevanMitra 2.0 Backend: Verification-First Multi-Layer Generative AI System for PM-AJAY Livelihood Matching & District Planning",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs = require('fs'); const path = require('path'); fs.mkdirSync('dist/database', { recursive: true }); fs.copyFileSync('src/database/schema.sql', 'dist/database/schema.sql');\"",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t jeevanmitra-backend .",
    "docker:run": "docker run -p 4000:4000 -v ./data:/app/data jeevanmitra-backend",
    "docker:compose": "docker-compose up --build"
  },
  "keywords": [
    "pm-ajay",
    "livelihood",
    "nsqf",
    "skilling",
    "rag",
    "governance",
    "voice-assistant",
    "district-planning"
  ],
  "author": "JeevanMitra Core Team",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
