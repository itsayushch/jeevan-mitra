datasource db {
  provider = "sqlite"
  url      = "file:./jeevanmitra.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(uuid())
  auth_provider_id String?
  name             String
  phone            String?
  email            String?
  role             String   @default("beneficiary") // beneficiary, field_worker, district_admin, counselor, system
  status           String   @default("active")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Beneficiary {
  id                 String              @id @default(uuid())
  name               String
  phone              String?
  gender             String              @default("prefer_not_to_say")
  age                Int?
  category           String              @default("SC")
  preferred_language String              @default("hi")
  district           String
  block              String
  village            String?
  contact_preference String              @default("voice")
  owner_type         String              @default("authenticated_user") // anonymous, authenticated_user, counselor_assisted
  owner_id           String?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  consents           Consent[]
  consent_records    ConsentRecord[]
  sessions           InterviewSession[]
  answers            ProfileAnswer[]
  field_values       ProfileFieldValue[]
  recommendations    Recommendation[]
  referrals          Referral[]
  referral_cases     ReferralCase[]
  outcomes           Outcome[]
}

model Consent {
  id                       String      @id @default(uuid())
  beneficiary              Beneficiary @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id           String
  purpose                  String
  notice_version           String      @default("1.0")
  audio_consent_recorded   Boolean     @default(true)
  voice_retention_choice   String      @default("do_not_keep")
  dpdp_affirmative_consent Boolean     @default(true)
  timestamp                DateTime    @default(now())
}

model ConsentRecord {
  id                String       @id @default(uuid())
  session_id        String?
  beneficiary       Beneficiary? @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id    String?
  consent_type      String       // ai_processing, profile_storage, counselor_referral, analytics, export_summary
  policy_version    String       @default("1.0")
  status            String       @default("granted") // granted, revoked
  revoked_at        DateTime?
  revocation_reason String?
  user_language     String       @default("hi")
  capture_channel   String       @default("web_app")
  timestamp         DateTime     @default(now())
}

model AnonymousSession {
  id            String   @id @default(uuid())
  session_token String   @unique
  owner_type    String   @default("anonymous") // anonymous, authenticated_user, counselor_assisted
  owner_id      String?
  expires_at    DateTime
  metadata      String?  @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model InterviewSession {
  id                     String              @id @default(uuid())
  beneficiary            Beneficiary?        @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id         String?
  session_id             String?             // Links to AnonymousSession token/id
  channel                String              @default("web_app")
  status                 String              @default("not_started") // not_started, collecting, awaiting_confirmation, ready_for_matching, recommendations_generated, referred, completed
  current_question_index Int                 @default(0)
  last_question          String?
  language               String              @default("hi")
  transcript_history     String              @default("[]")
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  answers                ProfileAnswer[]
  turns                  InterviewTurn[]
  field_values           ProfileFieldValue[]
  revisions              ProfileRevision[]
  recommendations        Recommendation[]
}

model InterviewTurn {
  id               String           @id @default(uuid())
  interview        InterviewSession @relation(fields: [interview_id], references: [id], onDelete: Cascade)
  interview_id     String
  turn_index       Int
  speaker          String           // user, ai, system
  text             String
  mode             String           @default("standard") // standard, guided_fallback, clarification
  extracted_fields String?          @default("{}")
  created_at       DateTime         @default(now())
}

model ProfileFieldValue {
  id               String            @id @default(uuid())
  interview        InterviewSession  @relation(fields: [interview_id], references: [id], onDelete: Cascade)
  interview_id     String
  beneficiary      Beneficiary?      @relation(fields: [beneficiary_id], references: [id], onDelete: SetNull)
  beneficiary_id   String?
  field_name       String
  field_value      String
  source           String            @default("ai_inferred") // user, ai_inferred, counselor, system
  confidence       Float             @default(1.0)
  user_confirmed   Boolean           @default(false)
  previous_value   String?
  version          Int               @default(1)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
}

model ProfileRevision {
  id               String           @id @default(uuid())
  interview        InterviewSession @relation(fields: [interview_id], references: [id], onDelete: Cascade)
  interview_id     String
  revision_number  Int              @default(1)
  profile_snapshot String           // JSON of confirmed fields
  created_by       String           @default("user")
  created_at       DateTime         @default(now())
}

model ProfileAnswer {
  id                  String            @id @default(uuid())
  beneficiary         Beneficiary       @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id      String
  session             InterviewSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  session_id          String?
  field_name          String
  field_value         String
  confidence_score    Float             @default(1.0)
  confirmation_status String            @default("unconfirmed")
  source              String            @default("voice_extraction")
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
}

model Qualification {
  id                  String             @id @default(uuid())
  nqr_code            String             @unique
  title               String
  sector              String
  nsqf_level          Int
  duration_hours      Int
  min_education       String
  min_education_rank  Int
  work_type           String
  physical_intensity  String             @default("light")
  skills_acquired     String
  curriculum_summary  String
  entry_criteria      String
  certification_body  String
  nqr_link            String
  official_source_url String?
  verification_status String             @default("verified")
  verification_date   DateTime
  last_verified_at    DateTime?
  opportunities       LocalOpportunity[]
  recommendations     Recommendation[]
  evidence_sources    EvidenceSource[]
}

model LocalOpportunity {
  id                      String           @id @default(uuid())
  qualification           Qualification    @relation(fields: [qualification_id], references: [id], onDelete: Cascade)
  qualification_id        String
  centre_or_employer_name String
  type                    String           @default("training_centre") // training_centre, employer_apprenticeship, enterprise_cluster, job, self_employment_support, other
  district                String
  block                   String
  state                   String           @default("Uttar Pradesh")
  address                 String
  latitude                Float
  longitude               Float
  batch_start_date        DateTime
  batch_end_date          DateTime
  total_seats             Int              @default(30)
  available_seats         Int              @default(15)
  sc_reserved_seats       Int              @default(10)
  batch_status            String           @default("active")
  availability            String           @default("verified_open") // verified_open, unknown, expired, closed
  hostel_available        Boolean          @default(false)
  stipend_amount_inr      Int              @default(0)
  free_toolkit_provided   Boolean          @default(true)
  source                  String           @default("pm_ajay_portal")
  source_url              String?
  contact_details         String?
  is_archived             Boolean          @default(false)
  verified_by_worker_id   String?
  verified_at             DateTime
  created_at              DateTime         @default(now())
  recommendations         Recommendation[]
  referrals               Referral[]
  referral_cases          ReferralCase[]
  evidence_sources        EvidenceSource[]
}

model EvidenceSource {
  id                   String            @id @default(uuid())
  qualification        Qualification?    @relation(fields: [qualification_id], references: [id], onDelete: Cascade)
  qualification_id     String?
  local_opportunity    LocalOpportunity? @relation(fields: [local_opportunity_id], references: [id], onDelete: Cascade)
  local_opportunity_id String?
  source_type          String            // nqr_portal, pm_ajay_portal, dsc_portal, field_verification
  source_url           String
  title                String
  verified_by          String
  verification_date    DateTime
  evidence_note        String?
  created_at           DateTime          @default(now())
}

model Recommendation {
  id                       String            @id @default(uuid())
  beneficiary              Beneficiary?      @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id           String?
  session                  InterviewSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  session_id               String?
  interview_id             String?
  qualification            Qualification     @relation(fields: [qualification_id], references: [id], onDelete: Restrict)
  qualification_id         String
  local_opportunity        LocalOpportunity? @relation(fields: [local_opportunity_id], references: [id], onDelete: SetNull)
  local_opportunity_id     String?
  rank                     Int
  score                    Float
  score_breakdown          String
  match_state              String            @default("Interest Match")
  explanation_text         String
  audio_explanation_script String
  tradeoff_summary         String
  skill_gap_summary        String
  data_snapshot            String
  ranking_factors          String?
  hard_constraint_result   String?
  matched_skills           String?           // JSON array
  skill_gaps               String?           // JSON array
  local_opportunity_status String            @default("unknown") // verified_open, unknown, expired, closed
  caveat                   String?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt
  referrals                Referral[]
  referral_cases           ReferralCase[]
}

model Referral {
  id                       String           @id @default(uuid())
  beneficiary              Beneficiary      @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id           String
  recommendation           Recommendation   @relation(fields: [recommendation_id], references: [id], onDelete: Restrict)
  recommendation_id        String
  local_opportunity        LocalOpportunity @relation(fields: [local_opportunity_id], references: [id], onDelete: Restrict)
  local_opportunity_id     String
  assigned_worker_id       String
  status                   String           @default("pending")
  notes                    String?
  caste_document_verified  Boolean          @default(false)
  income_criteria_verified Boolean          @default(false)
  residence_proof_verified Boolean          @default(false)
  sms_sent                 Boolean          @default(false)
  whatsapp_sent            Boolean          @default(false)
  next_follow_up           DateTime?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  outcomes                 Outcome[]
}

model ReferralCase {
  id                         String            @id @default(uuid())
  beneficiary                Beneficiary?      @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id             String?
  interview_id               String?
  recommendation             Recommendation?   @relation(fields: [recommendation_id], references: [id], onDelete: SetNull)
  recommendation_id          String?
  local_opportunity          LocalOpportunity? @relation(fields: [local_opportunity_id], references: [id], onDelete: SetNull)
  local_opportunity_id       String?
  referral_reason            String            // no_verified_local_option, user_requested_human_help, accessibility_support_required, complex_eligibility_query, low_confidence_profile, technical_issue
  consent_verification_state String            @default("verified")
  assigned_counselor_id      String?
  status                     String            @default("new") // new, assigned, contacted, in_progress, resolved, closed
  priority                   String            @default("medium") // low, medium, high, urgent
  follow_up_date             DateTime?
  outcome                    String?
  notes                      String?
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt
  counselor_notes            CounselorNote[]
}

model CounselorNote {
  id               String       @id @default(uuid())
  referral_case    ReferralCase @relation(fields: [referral_case_id], references: [id], onDelete: Cascade)
  referral_case_id String
  counselor_id     String
  note             String
  created_at       DateTime     @default(now())
}

model ExportAudit {
  id               String   @id @default(uuid())
  interview_id     String?
  beneficiary_id   String?
  exported_by      String
  export_type      String   @default("summary")
  consent_verified Boolean  @default(true)
  metadata         String?  @default("{}")
  created_at       DateTime @default(now())
}

model Outcome {
  id                          String      @id @default(uuid())
  beneficiary                 Beneficiary @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  beneficiary_id              String
  referral                    Referral?   @relation(fields: [referral_id], references: [id], onDelete: SetNull)
  referral_id                 String?
  enrolment_status            String      @default("enrolled")
  completion_status           String      @default("in_progress")
  dropout_reason              String?
  employment_status           String      @default("unemployed")
  employer_or_enterprise_name String?
  monthly_income_inr          Float?      @default(0)
  toolkit_received            Boolean     @default(false)
  seed_grant_applied          Boolean     @default(false)
  follow_up_date              DateTime?
  notes                       String?
  recorded_by_worker_id       String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt
}

model PlanningBrief {
  id                            String    @id @default(uuid())
  district                      String
  period                        String
  total_beneficiaries_interviewed Int
  total_verified_matches        Int
  total_supply_gaps             Int
  aggregation_snapshot          String
  generated_narrative           String
  suggested_policy_actions      String
  reviewer_sign_off_status      String    @default("draft")
  signed_off_by                 String?
  signed_off_at                 DateTime?
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt
}

model AuditEvent {
  id          String   @id @default(uuid())
  actor_id    String
  actor_name  String
  actor_role  String
  action      String
  entity_type String
  entity_id   String
  old_values  String?
  new_values  String?
  metadata    String?
  timestamp   DateTime @default(now())
}

model DriftAdvisory {
  id                     String   @id @default(uuid())
  district               String
  flag_type              String
  severity               String   @default("medium")
  headline               String
  evidence               String
  suggested_human_action String
  status                 String   @default("open")
  created_at             DateTime @default(now())
}
