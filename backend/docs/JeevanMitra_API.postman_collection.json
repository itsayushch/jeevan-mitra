    {
      "name": "3. Start Journey",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"whatsapp\",\n  \"language\": \"en\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/journey/start",
          "host": ["{{base_url}}"],
          "path": ["journey", "start"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 201\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Has journey_id and session_id\", function () {",
              "    pm.expect(jsonData).to.have.property('journey_id');",
              "    pm.expect(jsonData).to.have.property('session_id');",
              "});",
              "pm.environment.set(\"journey_id\", jsonData.journey_id);",
              "pm.environment.set(\"session_id\", jsonData.session_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
