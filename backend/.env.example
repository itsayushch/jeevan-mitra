# JeevanMitra 2.0 Backend Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite with WAL mode; zero-cloud local execution)
DATABASE_PATH=./jeevanmitra.db

# Pilot District & State (Matches MoSJE PM-AJAY GIA pilot)
DEFAULT_DISTRICT=Moradabad
DEFAULT_STATE=Uttar Pradesh

# Required for field-worker API routes; use a long random value and configured worker identity.
WORKER_API_KEY=
WORKER_ID=
WORKER_NAME=

# AI Provider Configuration
# Supported: 'mock' (instant deterministic tests/demo), 'openai', 'bhashini', 'sarvam'
AI_PROVIDER=mock
OPENAI_API_KEY=
BHASHINI_API_KEY=
SARVAM_API_KEY=

# Structured Profiling Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.75

# Freshness thresholds
QUALIFICATION_REVIEW_DAYS=180
OPPORTUNITY_REVIEW_DAYS=30
