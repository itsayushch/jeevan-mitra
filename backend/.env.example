# JeevanMitra 2.0 Backend Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# Local SQLite with WAL mode. Keep DATABASE_URL empty for local development.
DATABASE_PATH=./jeevanmitra.db
# Optional remote PostgreSQL override (takes precedence over DATABASE_PATH)
DATABASE_URL=

# Authentication
# Secret key for JWT token generation and validation
JWT_SECRET=supersecret_jwt_key_for_dev_only

# Pilot District & State (Matches MoSJE PM-AJAY GIA pilot)
DEFAULT_DISTRICT=Moradabad
DEFAULT_STATE=Uttar Pradesh

# AI Provider Configuration
# Conversational intake: 'gemini' or 'groq' for LLM extraction, 'mock' for guided intake.
AI_PROVIDER=groq
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Structured Profiling Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.75

# Freshness thresholds
QUALIFICATION_REVIEW_DAYS=180
OPPORTUNITY_REVIEW_DAYS=30

# Bundled synthetic-trained ranking aid; false uses rules only.
ML_RANKING_ENABLED=true
# Cloud voice: no GPU. 'edge' streams neural speech; 'sarvam' uses the configured key.
VOICE_TTS_PROVIDER=edge
VOICE_EN_VOICE=en-IN-NeerjaNeural
VOICE_HI_VOICE=hi-IN-SwaraNeural
GROQ_STT_MODEL=whisper-large-v3-turbo
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
