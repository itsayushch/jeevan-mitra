# JeevanMitra 2.0 Backend Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite with WAL mode; zero-cloud local execution)
DATABASE_PATH=./jeevanmitra.db

# Pilot District & State (Matches MoSJE PM-AJAY GIA pilot)
DEFAULT_DISTRICT=Moradabad
DEFAULT_STATE=Uttar Pradesh

# Required for field-worker API routes; use a long random value and configured worker identity.
WORKER_API_KEY=
WORKER_ID=
WORKER_NAME=

# AI Provider Configuration
# Supported: 'mock' (instant deterministic tests/demo), 'openai', 'bhashini', 'sarvam'
AI_PROVIDER=mock
OPENAI_API_KEY=
BHASHINI_API_KEY=
SARVAM_API_KEY=

# Structured Profiling Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.75

# Freshness thresholds
QUALIFICATION_REVIEW_DAYS=180
OPPORTUNITY_REVIEW_DAYS=30

# IVR Configuration (Supported IVR_PROVIDER: 'mock', 'exotel', 'twilio')
IVR_PROVIDER=mock
IVR_DEFAULT_LANGUAGE=hi-IN
IVR_SESSION_TIMEOUT_SECONDS=600
IVR_MAX_INVALID_ATTEMPTS=2
IVR_SIMULATOR_ENABLED=true
IVR_AUDIO_BASE_URL=
PUBLIC_BASE_URL=http://localhost:4000

# Telephony Provider Credentials (Optional for mock mode; configure when deploying with live provider)
# Exotel Configuration
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
